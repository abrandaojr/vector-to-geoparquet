# Normalize line endings for all text files on commit.
# Git will convert to LF in the repository and to the
# platform native ending on checkout.
* text=auto

# Force LF for Python and config files regardless of platform.
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files -- no conversion.
*.parquet binary
*.gpkg    binary
*.shp     binary
*.dbf     binary
*.shx     binary
